{
  "name": "attendance-pro-functions",
  "version": "1.0.0",
  "description": "Attendance Pro Multi-Store Firebase Cloud Functions (RTDB + Auth + FCM + Cloudinary)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,database",
    "deploy": "firebase deploy --only functions,database",
    "test": "node --test test/rules.test.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^6.2.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.5",
    "typescript": "^5.7.2"
  }
}
